<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SmartHopper.DocumentProcessing</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmartHopper.ProviderSdk\SmartHopper.ProviderSdk.csproj" />
    <!-- Build ordering + isolated packaging: the renderer assembly/natives are staged into
         a dedicated DocumentRendering folder beside this project's output via the
         PackageDocumentRendering target below. It is NEVER referenced at compile time,
         and its package dependencies must not leak into consumers' default output. -->
    <ProjectReference Include="..\SmartHopper.DocumentRendering\SmartHopper.DocumentRendering.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.13" />
  </ItemGroup>

  <!-- Stage the isolated renderer into this project's deployable output. -->
  <Import Project="..\SmartHopper.DocumentRendering\DocumentRendering.Packaging.targets" />
</Project>
