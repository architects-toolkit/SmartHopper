<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SmartHopper.DocumentRendering</AssemblyName>
    <!-- RID restore so the packaging target can publish per-RID outputs with natives. -->
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Isolated implementation assembly: loaded through a dedicated AssemblyLoadContext
         by SmartHopper.DocumentProcessing. It is never referenced at compile time.
         Strong-named like every own assembly by the shared build props. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
  </ItemGroup>
</Project>
