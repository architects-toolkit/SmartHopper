<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net7.0-windows;net7.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SmartHopper.DocumentProcessing.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SmartHopper.DocumentProcessing\SmartHopper.DocumentProcessing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TestAssets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.4.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
    <!-- Lift xunit's vulnerable NETStandard.Library 1.6.1 transitive pins, matching
         the versions used by the other test projects. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>
  <!-- Stage the isolated renderer into this test host's output (its own bin folder). -->
  <Import Project="..\SmartHopper.DocumentRendering\DocumentRendering.Packaging.targets" />
</Project>
